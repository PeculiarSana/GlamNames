<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.1.0.0</Version>
    <Author>PeculiarSana</Author>
    <Name>Glamour Names</Name>
    <Punchline>Change the display name of glamour plates.</Punchline>
    <Description>A simple plugin that allows editing of the Glamour display names via a new button on the Glamour Plates window.</Description>
    <RepoUrl>https://github.com/PeculiarSana/GlamNames</RepoUrl>
    <Tags>glamour;interface;text</Tags>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="GlamNames.json" />
    <Content Include="..\images\icon.png" Link="images\icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
